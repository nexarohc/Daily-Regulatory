# Timely Regulatory - environment configuration
# Copy to .env and adjust. Every value here has a working default except
# SESSION_SECRET, which you should always set in production.

# --- server -----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- sessions ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, a random secret is generated at boot and restarts sign everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Set to 1 when serving over HTTPS.
COOKIE_SECURE=0

# --- storage ----------------------------------------------------------------
# SQLite file. Must be on persistent storage: it holds accounts and feed history.
DB_FILE=data/timely-regulatory.db
RETENTION_DAYS=180

# --- ingestion --------------------------------------------------------------
POLL_INTERVAL_MINUTES=15
FETCH_TIMEOUT_MS=20000
FETCH_CONCURRENCY=6
# Set to 0 to poll from cron with "npm run ingest" instead of in-process.
AUTO_INGEST=1
# Load the clearly-labelled sample corpus when no feed can be reached.
SEED_WHEN_EMPTY=1
# Identify yourself to the authorities you poll; put a reachable contact in here.
FEED_USER_AGENT=TimelyRegulatory/1.0 (+https://your-domain.example; ops@your-domain.example)

# --- access control ---------------------------------------------------------
# Hold new registrations in "pending" until an administrator approves them.
REQUIRE_APPROVAL=0
# This address is promoted to administrator when it registers.
ADMIN_EMAIL=

# --- two-step sign-in (passcode by email) -----------------------------------
# A one-time passcode is mandatory for every sign-in. Only disable this for a
# deployment with no mail service at all.
REQUIRE_LOGIN_PASSCODE=1
PASSCODE_TTL_MINUTES=10
PASSCODE_MAX_ATTEMPTS=5
RESET_TTL_MINUTES=60

# --- email (required to deliver passcodes and reset links) ------------------
# Without SMTP_HOST, passcodes are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Timely Regulatory <no-reply@your-domain.example>
# Used to build password reset links in email.
PUBLIC_URL=https://your-domain.example

# --- subscriptions and billing ----------------------------------------------
# Checkout link shown to subscribers as "Top up / renew" (e.g. a Stripe payment
# link). Left blank, the button is hidden rather than shown broken.
PAYMENT_URL=
CURRENCY=USD
PLAN_AMOUNT=0
TRIAL_DAYS=14
RENEWAL_WARNING_DAYS=14
