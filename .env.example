# Daily Regulatory - Environment Configuration

# Server
NODE_ENV=production
PORT=3000

# JWT Secret (Change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-2024

# Database (Optional - current version uses in-memory storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/daily_regulatory

# API Keys for Health Authorities (Optional - add if you have them)
FDA_API_KEY=
EMA_API_KEY=
PMDA_API_KEY=
NMPA_API_KEY=

# Email Service (Optional)
SENDGRID_API_KEY=
NOTIFICATION_EMAIL=alerts@dailyregulatory.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
